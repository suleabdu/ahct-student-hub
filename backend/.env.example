# =============================================================================
# AH Student Hub — backend environment variables
# Copy this file to .env for local development ("cp .env.example .env") and
# fill in real values. On Render, set these under the service's
# Environment tab instead of using a .env file — see docs/SETUP_GUIDE.md.
# =============================================================================

# --- Flask / security ---------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET=change-this-to-a-different-long-random-string

# --- Google Sheets / Drive ("the database") -----------------------------
# The spreadsheet's ID — the long string in its URL between /d/ and /edit.
SPREADSHEET_ID=

# OAuth credentials for the Google account that owns the spreadsheet — NOT
# a service account (a service account has no personal Drive storage of
# its own; see services/sheets.py's module docstring for why). Generate
# all three of these ONCE, locally, by running setup/get_refresh_token.py
# — see docs/SETUP_GUIDE.md, Steps 2-4. It prints exactly these three
# lines for you to paste in here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional: a Drive folder ID under which the app's upload folders
# (AHCT_Passports, etc.) are created. Leave blank to create them at the
# root of that Google account's own Drive.
DRIVE_PARENT_FOLDER_ID=

ADMIN_EMAIL=ahstudenthub@gmail.com

# --- CORS -----------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API, e.g.
# https://your-site.netlify.app,http://localhost:8888
# "*" is fine for local development only — lock this down before going live.
CORS_ORIGINS=*

# --- Business settings -----------------------------------------------------
DEFAULT_PASSWORD=123456
RESET_TOKEN_VALID_HOURS=2
SESSION_TIMEOUT_MINUTES=30
MIN_PASSWORD_LENGTH=8

# --- Frontend URL (used inside outbound emails) ----------------------------
FRONTEND_URL=http://localhost:8888

# --- Email (SMTP) -----------------------------------------------------------
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_NAME=AH Student Hub
MAIL_FROM_ADDRESS=

# --- Payments (optional — static account used until this is enabled) -------
MONNIFY_ENABLED=false
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://sandbox.monnify.com

STATIC_BANK_NAME=Moniepoint MFB
STATIC_ACCOUNT_NUMBER=5210214244
STATIC_ACCOUNT_NAME=AH CONSULT LTD
